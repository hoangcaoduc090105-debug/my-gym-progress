{
  "name": "my-gym-progress",
  "private": true,
  "version": "1.8.2",
  "type": "module",
  "description": "Ứng dụng local-first theo dõi tập gym, số đo cơ thể và dinh dưỡng. Không backend, không AI API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "audit:network": "node scripts/audit-no-external.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run audit:network",
    "docs": "vite-node scripts/generate-guides.ts",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "6.2.7",
    "jsdom": "25.0.1",
    "playwright": "1.63.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
